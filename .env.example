# IMAP Configuration
IMAP_HOST=mail.thanhvu.net
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# Mail domains for temp email (comma-separated)
MAIL_DOMAINS=mail.thanhvu.net

# Email retention (hours)
EMAIL_RETENTION_HOURS=24

# Server
PORT=3005

# SQLite database path (optional, defaults to ./data/tempmail.db)
DB_PATH=/app/data/tempmail.db
